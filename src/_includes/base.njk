<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title | safe }}</title>
<meta name="description" content="{{ description | safe }}">
<link rel="canonical" href="{{ canonical | safe }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title | safe }}">
<meta property="og:description" content="{{ description | safe }}">
<meta property="og:url" content="{{ canonical | safe }}">
<meta property="og:image" content="https://kinorpartners.com/assets/img/og-cover.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Kinor Partners - AI-driven eCommerce and growth agency">
<meta property="og:site_name" content="Kinor Partners">
<meta name="twitter:image" content="https://kinorpartners.com/assets/img/og-cover.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/png" href="/assets/img/icon-192.png" sizes="192x192">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#0767dd">
<link rel="stylesheet" href="/assets/site.css">
<script>
(function () {
  var id = 'G-H6T60VVJ27';
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { window.dataLayer.push(arguments); };
  if (navigator.globalPrivacyControl === true) {
    window['ga-disable-' + id] = true;
    return;
  }
  var script = document.createElement('script');
  script.async = true;
  script.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
  document.head.appendChild(script);
  window.gtag('js', new Date());
  window.gtag('config', id);
})();
</script>
{% for block in jsonld %}<script type="application/ld+json">{{ block | safe }}</script>
{% endfor %}</head>
<body>{% include "header.njk" %}<main>{{ content | safe }}</main>{% include "footer.njk" %}
<script src="/assets/js/nav.js"></script>
</body></html>